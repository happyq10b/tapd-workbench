# 统一行尾：仓库内一律 LF，检出到 Windows 时由 core.autocrlf 处理
* text=auto eol=lf

*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.conf  text eol=lf
*.txt   text eol=lf

# 二进制文件不做行尾转换
*.db    binary
*.db-wal binary
*.db-shm binary
*.zip   binary
*.gz    binary
*.png   binary
*.jpg   binary
*.ico   binary

# Windows 批处理：GBK 编码的中文 + CRLF，必须原样保存，禁止任何转换
*.bat binary
