# ── 密钥与凭据（绝对不能进 git）────────────────────────
ops/secrets/
*.pem
*.key
!ops/*.key
id_rsa*
id_ed25519*

# ── 验证凭证（本地生成，不入库）──
ops/.verify-stamp

# ── Python ────────────────────────────────────────────
ops/.localvenv/
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── 数据库（真实数据在服务器上，本地仅副本）──────────
*.db
*.db-wal
*.db-shm

# ── 归档（体积大，用文件路径引用，不进版本库）────────
archive/packages/
archive/backup/

# ── 系统与编辑器 ─────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# ── 本地服务运行时产物（不入库）──
ops/.localdev.pid
ops/.localdev.log

# ── 交接文档写入前的过程备份（不入库）──
HANDOFF.md.bak

# ── UI 截图留档（本地生成，不入库）────────────────────
ops/.shots/
data/
ops/backup_legacy_users_*.json
