[Unit]
Description=TAPD Workbench (DEV env, port 8001 via nginx 8443)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tapd-dev
ExecStart=/usr/local/bin/tapd-dev-run
Restart=always
RestartSec=3
StandardOutput=append:/var/log/tapd-dev.log
StandardError=append:/var/log/tapd-dev.log

[Install]
WantedBy=multi-user.target
